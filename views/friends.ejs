<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Friends - Spotify Vibe</title>
  <link rel="stylesheet" href="/styles/index.css" />
  <style>
    .friends-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
      text-align: center;
    }

    .friend-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      justify-items: center;
    }

    .friend-card {
      background-color: rgba(255, 255, 255, 0.08);
      padding: 20px;
      border: 1px solid #1db954;
      border-radius: 12px;
      width: 100%;
      max-width: 250px;
      transition: transform 0.3s ease, background-color 0.3s ease;
      cursor: pointer;
    }

    .friend-card:hover {
      background-color: rgba(29, 185, 84, 0.2);
      transform: scale(1.05);
    }

    .friend-card .username {
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 30px;
      color: #1db954;
    }

    .error-message {
      color: #ff4c4c;
      margin-bottom: 20px;
    }

    #friend-suggestions-section,
    #common-songs-section {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 20px;
      text-align: center;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">🎧 Spotify Vibe</div>
    <ul class="nav-links">
      <li><a href="/home">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/friends">My Friends</a></li>
      <li><a href="/my-playlists">My Playlists</a></li>
      <% if (user) { %>
        <li><a href="/profile">My Profile</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
      <% } %>
    </ul>
  </nav>

  <main class="main-content">
    <div class="friends-container">
      <h2 class="section-title">My Friends</h2>
      <% if (error) { %>
        <p class="error-message"><%= error %></p>
      <% } else if (friends && friends.length > 0) { %>
        <div class="friend-grid">
          <% friends.forEach(function(friend) { %>
            <div class="friend-card" data-friend-id="<%= friend.UserID %>">
              <div><%= friend.Firstname %> <%= friend.Lastname %></div>
              <div class="username">(<%= friend.Username %>)</div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p>You have no friends added yet.</p>
      <% } %>
    </div>
  </main>

  <section id="friend-suggestions-section">
    <h2 class="section-title">Friend Suggestions</h2>
    <ul id="friend-suggestions-list"></ul>
  </section>

  <section id="common-songs-section">
    <h3 id="common-songs-title">Common Songs with Selected Friend</h3>
    <ul id="common-songs-list"></ul>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const commonSongsList = document.getElementById('common-songs-list');
      const commonSongsSection = document.getElementById('common-songs-section');
      const friendSuggestionsList = document.getElementById('friend-suggestions-list');
      const friendCards = document.querySelectorAll('.friend-card');

      commonSongsSection.style.display = 'none';

      async function loadFriendSuggestions() {
        try {
          const response = await fetch('/friend-suggestions');
          if (!response.ok) throw new Error('Failed to fetch friend suggestions');

          const data = await response.json();
          const suggestions = data.suggestions;
          friendSuggestionsList.innerHTML = '';

          if (suggestions.length === 0) {
            friendSuggestionsList.innerHTML = '<li>No friend suggestions available.</li>';
          } else {
            suggestions.forEach(friend => {
              const li = document.createElement('li');
              li.textContent = `${friend.Firstname} ${friend.Lastname} (${friend.Username}) `;
              li.setAttribute('data-friend-id', friend.UserID);

              const addButton = document.createElement('button');
              addButton.textContent = 'Add Friend';
              addButton.style.marginLeft = '10px';
              addButton.addEventListener('click', async () => {
                try {
                  const res = await fetch('/add-friend', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ friendId: friend.UserID })
                  });
                  if (!res.ok) throw new Error('Failed to add friend');

                  friendSuggestionsList.removeChild(li);
                  addFriendToList(friend);
                } catch (error) {
                  alert('Error adding friend: ' + error.message);
                }
              });

              li.appendChild(addButton);
              friendSuggestionsList.appendChild(li);
            });
          }
        } catch (error) {
          friendSuggestionsList.innerHTML = '<li>Error loading friend suggestions.</li>';
        }
      }

      function addFriendToList(friend) {
        const friendsGrid = document.querySelector('.friend-grid');
        if (!friendsGrid) return;

        const card = document.createElement('div');
        card.className = 'friend-card';
        card.setAttribute('data-friend-id', friend.UserID);

        card.innerHTML = `
          <div>${friend.Firstname} ${friend.Lastname}</div>
          <div class="username">(${friend.Username})</div>
        `;

        card.addEventListener('click', () => fetchCommonSongs(friend.UserID, `${friend.Firstname} ${friend.Lastname}`));
        friendsGrid.appendChild(card);
      }

      function fetchCommonSongs(friendId, friendName) {
        fetch(`/friends/${friendId}/common-songs`)
          .then(res => {
            if (!res.ok) throw new Error('Failed to fetch common songs');
            return res.json();
          })
          .then(data => {
            const songs = data.songs;
            document.getElementById('common-songs-title').textContent = `Your BLEND with ${friendName}`;
            commonSongsList.innerHTML = songs.length > 0 ? songs.map(s => `<li>${s.Title}</li>`).join('') : '<li>No common songs found.</li>';
            commonSongsSection.style.display = 'block';
          })
          .catch(error => alert('Error loading common songs: ' + error.message));
      }

      friendCards.forEach(card => {
        const friendId = card.getAttribute('data-friend-id');
        const friendName = card.textContent.trim();
        card.addEventListener('click', () => fetchCommonSongs(friendId, friendName));
      });

      loadFriendSuggestions();
    });
  </script>
</body>
</html>
