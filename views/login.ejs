<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Friends - Spotify Vibe</title>
  <link rel="stylesheet" href="/styles/index.css" />
  <style>
    .friend-list {
      list-style-type: none;
      padding-left: 0;
    }
    .friend-list li {
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">🎧 Spotify Vibe</div>
    <ul class="nav-links">
      <li><a href="/home">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/friends">My Friends</a></li>
      <li><a href="/my-playlists">My Playlists</a></li>
      <% if (user) { %>
        <li><a href="/profile">My Profile</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
      <% } %>
    </ul>
  </nav>

  <main class="main-content">
    <div class="container">
      <h2>My Friends</h2>
      <% if (error) { %>
        <p class="error-message"><%= error %></p>
      <% } else if (friends && friends.length > 0) { %>
        <ul class="friend-list">
          <% friends.forEach(function(friend) { %>
            <li data-friend-id="<%= friend.UserID %>"><%= friend.Firstname %> <%= friend.Lastname %> (<%= friend.Username %>)</li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>You have no friends added yet.</p>
      <% } %>
    </div>
  </main>

  <section id="friend-suggestions-section" style="margin-top: 20px;">
    <h2>Friend Suggestions</h2>
    <ul id="friend-suggestions-list"></ul>
  </section>

  <section id="common-songs-section" style="margin-top: 20px;">
    <h3 id="common-songs-title">Common Songs with Selected Friend</h3>
    <ul id="common-songs-list"></ul>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const friendItems = document.querySelectorAll('.friend-list li');
      const commonSongsList = document.getElementById('common-songs-list');
      const commonSongsSection = document.getElementById('common-songs-section');
      const friendSuggestionsList = document.getElementById('friend-suggestions-list');

      // Hide common songs section initially
      commonSongsSection.style.display = 'none';

      // Load friend suggestions from backend
      async function loadFriendSuggestions() {
        try {
          const response = await fetch('/friend-suggestions');
          if (!response.ok) {
            throw new Error('Failed to fetch friend suggestions');
          }
          const data = await response.json();
          const suggestions = data.suggestions;

          friendSuggestionsList.innerHTML = '';

          if (suggestions.length === 0) {
            friendSuggestionsList.innerHTML = '<li>No friend suggestions available.</li>';
          } else {
            suggestions.forEach(friend => {
              const li = document.createElement('li');
              li.textContent = `${friend.Firstname} ${friend.Lastname} (${friend.Username}) `;
              li.setAttribute('data-friend-id', friend.UserID);

              const addButton = document.createElement('button');
              addButton.textContent = 'Add Friend';
              addButton.style.marginLeft = '10px';
              addButton.addEventListener('click', async () => {
                try {
                  const res = await fetch('/add-friend', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ friendId: friend.UserID })
                  });
                  if (!res.ok) {
                    throw new Error('Failed to add friend');
                  }
                  // Remove from suggestions
                  friendSuggestionsList.removeChild(li);

                  // Add to friends list dynamically
                  addFriendToList(friend);
                } catch (error) {
                  alert('Error adding friend: ' + error.message);
                }
              });

              li.appendChild(addButton);
              friendSuggestionsList.appendChild(li);
            });
          }
        } catch (error) {
          friendSuggestionsList.innerHTML = '<li>Error loading friend suggestions.</li>';
        }
      }

      // Add friend to friends list dynamically
      function addFriendToList(friend) {
        const friendsList = document.querySelector('.friend-list');
        if (!friendsList) return;

        const li = document.createElement('li');
        li.textContent = `${friend.Firstname} ${friend.Lastname} (${friend.Username})`;
        li.setAttribute('data-friend-id', friend.UserID);
        li.style.cursor = 'pointer';

        // Add click event to fetch common songs
        li.addEventListener('click', async () => {
          const friendId = li.getAttribute('data-friend-id');
          if (!friendId) return;

          const friendName = li.textContent.trim();

          try {
            const response = await fetch(`/friends/${friendId}/common-songs`);
            if (!response.ok) {
              throw new Error('Failed to fetch common songs');
            }
            const data = await response.json();
            const songs = data.songs;

            const title = document.getElementById('common-songs-title');
            title.textContent = `Your BLEND with ${friendName}`;

            commonSongsList.innerHTML = '';

            if (songs.length === 0) {
              commonSongsList.innerHTML = '<li>No common songs found.</li>';
            } else {
              songs.forEach(song => {
                const li = document.createElement('li');
                li.textContent = song.Title;
                commonSongsList.appendChild(li);
              });
            }

            commonSongsSection.style.display = 'block';
          } catch (error) {
            alert('Error loading common songs: ' + error.message);
          }
        });

        friendsList.appendChild(li);
      }

      // Attach click event to existing friends
      friendItems.forEach(item => {
        item.style.cursor = 'pointer';
        item.addEventListener('click', async () => {
          const friendId = item.getAttribute('data-friend-id');
          if (!friendId) return;

          const friendName = item.textContent.trim();

          try {
            const response = await fetch(`/friends/${friendId}/common-songs`);
            if (!response.ok) {
              throw new Error('Failed to fetch common songs');
            }
            const data = await response.json();
            const songs = data.songs;

            const title = document.getElementById('common-songs-title');
            title.textContent = `Your BLEND with ${friendName}`;

            commonSongsList.innerHTML = '';

            if (songs.length === 0) {
              commonSongsList.innerHTML = '<li>No common songs found.</li>';
            } else {
              songs.forEach(song => {
                const li = document.createElement('li');
                li.textContent = song.Title;
                commonSongsList.appendChild(li);
              });
            }

            commonSongsSection.style.display = 'block';
          } catch (error) {
            alert('Error loading common songs: ' + error.message);
          }
        });
      });

      // Load friend suggestions on page load
      loadFriendSuggestions();
    });
  </script>
</body>
</html>
</create_file>
