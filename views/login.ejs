<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login / Signup - Spotify Vibe</title>
  <link rel="stylesheet" href="/styles/index.css" />
  <style>
    .error-message {
      color: red;
    }
    .hidden {
      display: none;
    }
    .toggle-buttons {
      margin-bottom: 20px;
    }
    .toggle-buttons button {
      margin-right: 10px;
      padding: 8px 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">🎧 Spotify Vibe</div>
    <ul class="nav-links">
      <li><a href="/home">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/friends">My Friends</a></li>
      <li><a href="/my-playlists">My Playlists</a></li>
      <% if (user) { %>
        <li><a href="/profile">My Profile</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
      <% } %>
    </ul>
  </nav>

  <main class="main-content">
    <div class="container">
      <div class="toggle-buttons">
        <button id="login-toggle" type="button">Login</button>
        <button id="signup-toggle" type="button">Signup</button>
      </div>

      <div id="login-section">
        <h2>Login</h2>
        <% if (error && errorType === 'login') { %>
          <p class="error-message"><%= error %></p>
        <% } %>
        <form action="/login" method="POST" id="login-form">
          <label for="login-username">Username:</label>
          <input type="text" id="login-username" name="username" required />
          <label for="login-password">Password:</label>
          <input type="password" id="login-password" name="password" required />
          <button type="submit">Login</button>
        </form>
      </div>

      <div id="signup-section" class="hidden">
        <h2>Signup</h2>
        <% if (error && errorType === 'signup') { %>
          <p class="error-message"><%= error %></p>
        <% } %>
        <form action="/signup" method="POST" id="signup-form">
          <label for="firstname">First Name:</label>
          <input type="text" id="firstname" name="Firstname" required />
          <label for="lastname">Last Name:</label>
          <input type="text" id="lastname" name="Lastname" required />
          <label for="signup-username">Username:</label>
          <input type="text" id="signup-username" name="Username" required />
          <label for="email">Email:</label>
          <input type="email" id="email" name="EmailID" required />
          <label for="signup-password">Password:</label>
          <input type="password" id="signup-password" name="Phoneno" required />
          <button type="submit">Signup</button>
        </form>
      </div>
    </div>
  </main>

  <script>
    const loginToggle = document.getElementById('login-toggle');
    const signupToggle = document.getElementById('signup-toggle');
    const loginSection = document.getElementById('login-section');
    const signupSection = document.getElementById('signup-section');

    loginToggle.addEventListener('click', () => {
      loginSection.classList.remove('hidden');
      signupSection.classList.add('hidden');
    });

    signupToggle.addEventListener('click', () => {
      signupSection.classList.remove('hidden');
      loginSection.classList.add('hidden');
    });

    // If errorType is signup, show signup form by default
    const errorType = "<%= errorType || '' %>";
    if (errorType === 'signup') {
      signupSection.classList.remove('hidden');
      loginSection.classList.add('hidden');
    }
  </script>
</body>
</html>
